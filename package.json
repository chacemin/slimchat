{
	"name": "slimchat",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.2"
	},
	"scripts": {
		"dev": "bun --watch server/index.ts",
		"start": "bun server/index.ts",
		"dev:frontend": "vite --config frontend/vite.config.js",
		"build": "bun run build:frontend",
		"build:frontend": "vite build --config frontend/vite.config.js",
		"build:capacitor:web": "vite build --config frontend/vite.capacitor.config.js",
		"capacitor:sync": "bun run build:capacitor:web && cd capacitor && npx cap sync android",
		"build:capacitor": "bun run capacitor:sync && bun capacitor/scripts/run-gradle.mjs",
		"open:capacitor:android": "cd capacitor && npx cap open android",
		"db:migrate": "bun scripts/migrate.ts",
		"admin:bootstrap": "bun scripts/admin-bootstrap.ts",
		"keyring:init": "bun scripts/keyring.ts init",
		"keyring:rotate": "bun scripts/keyring.ts rotate",
		"backup": "bun scripts/backup.ts",
		"restore": "bun scripts/restore.ts",
		"test": "bun test",
		"vditor:assets": "bun .github/scripts/prepare-vditor-assets.mjs",
		"prebuild:frontend": "bun run vditor:assets",
		"prebuild:capacitor:web": "bun run vditor:assets",
		"predev:frontend": "bun run vditor:assets",
		"test:editor-security": "bun run vditor:assets && bun .github/scripts/check-vditor-security.mjs",
		"check:frontend-size": "bun run vditor:assets && bun .github/scripts/check-frontend-size.mjs",
		"biome:write": "biome check --write .",
		"biome:check": "biome check .",
		"biome:ci": "biome ci .",
		"check": "bun run biome:ci && bun run build",
		"build:standalone": "bun run build && bun scripts/build-standalone.ts",
		"build:standalone:linux-x64": "bun run build && bun scripts/build-standalone.ts bun-linux-x64",
		"build:standalone:linux-arm64": "bun run build && bun scripts/build-standalone.ts bun-linux-arm64",
		"build:standalone:windows-x64": "bun run build && bun scripts/build-standalone.ts bun-windows-x64",
		"build:standalone:darwin-x64": "bun run build && bun scripts/build-standalone.ts bun-darwin-x64",
		"build:standalone:darwin-arm64": "bun run build && bun scripts/build-standalone.ts bun-darwin-arm64"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.1",
		"@capacitor/core": "^8.5.1",
		"@lucide/vue": "^1.28.0",
		"bowser": "^2.14.1",
		"dompurify": "^3.4.17",
		"hono": "^4.13.16",
		"markdown-it": "^15.0.3",
		"vditor": "^4.0.0",
		"vue": "^3.5.42",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@capacitor/cli": "^8.5.1",
		"@types/bun": "latest",
		"@vitejs/plugin-vue": "^6.0.8",
		"playwright": "1.63.0",
		"sql.js": "1.14.2",
		"typescript": "^5.9.0",
		"vite": "^8.2.1"
	}
}
