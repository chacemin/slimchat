# ── 服务 ──────────────────────────────
SLIMCHAT_HOST=127.0.0.1
SLIMCHAT_PORT=8787
SLIMCHAT_DATA_DIR=./data
# ── 这个一定要改成自己的地址，否则聊天会受到影响 ──────────────────────────────
SLIMCHAT_PUBLIC_ORIGIN=https://www.yourdomain.fun
SLIMCHAT_SITE_ORIGINS=https://www.yourdomain.fun,http://127.0.0.1:8787
SLIMCHAT_TRUST_PROXY=true


# ── 管理员（仅首次初始化读取） ─────────
SLIMCHAT_ADMIN_USERNAME=admin
SLIMCHAT_ADMIN_PASSWORD=
SLIMCHAT_ADMIN_DISPLAY_NAME=管理员

# ── 存储与加密 ────────────────────────
SLIMCHAT_KEYRING_FILE=./data/secrets/keyring.json
SLIMCHAT_MAX_FILE_SIZE=20971520
SLIMCHAT_ALLOWED_FILE_TYPES=image/,video/,audio/,application/pdf,text/
SLIMCHAT_SITE_ORIGINS=http://127.0.0.1:8787

# ── 会话与限流 ────────────────────────
SLIMCHAT_SESSION_TTL_DAYS=30
SLIMCHAT_LOGIN_LIMIT=10
SLIMCHAT_API_LIMIT=120
SLIMCHAT_LOGIN_GATE_ENABLED=false
# 启用登录门槛时必填；只存在本机 .env 中
SLIMCHAT_LOGIN_GATE_PASSWORD=

# ── 维护策略 ──────────────────────────
SLIMCHAT_MESSAGE_RETENTION_DAYS=30
SLIMCHAT_SOFT_DELETE_RETENTION_DAYS=60
SLIMCHAT_ORPHAN_UPLOAD_RETENTION_DAYS=1
SLIMCHAT_GC_CRON_HOUR=3
SLIMCHAT_LOG_LEVEL=info

# ── 语音（P2P + 本地 coturn） ──────────
# 留空则仅 P2P 直连；跨网段通话需填写本地/内网 coturn。
SLIMCHAT_TURN_URL=
SLIMCHAT_TURN_USERNAME=
SLIMCHAT_TURN_CREDENTIAL=
# 可选：coturn --use-auth-secret 的共享密钥，进程内生成短期凭据
SLIMCHAT_TURN_SHARED_SECRET=

# ── Docker Compose（可选） ──────────────
# 仅影响宿主机端口发布，不写入应用配置
# SLIMCHAT_PUBLISH_ADDRESS=127.0.0.1
# SLIMCHAT_PUBLISH_PORT=8787
